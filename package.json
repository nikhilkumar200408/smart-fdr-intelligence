{ "name": "smart-fdr-intelligence", "private": true, "workspaces": ["apps/*"],
  "scripts": { "dev:api": "npm -w apps/api run dev", "dev:web": "npm -w apps/web run dev",
    "db:push": "npm -w apps/api run db:push", "seed": "npm -w apps/api run seed",
    "typecheck": "npm -w apps/api run typecheck && npm -w apps/web exec tsc -- --noEmit",
    "test": "npm -w apps/api run test", "build": "npm -w apps/web run build" } }
