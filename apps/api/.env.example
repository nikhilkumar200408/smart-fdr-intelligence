# Copy to .env (never commit .env)
PORT=4000
DATABASE_URL=postgresql://fdr:fdr@localhost:5432/fdr
# Required in production. In development a random secret is generated per start if empty.
JWT_SECRET=
NODE_ENV=development
COOKIE_SECURE=false
WEB_ORIGIN=http://localhost:5173
STORAGE_DIR=./storage
MAX_UPLOAD_MB=5
# Email/SMS are NOT implemented. Leave unset; notifications are in-app only.
